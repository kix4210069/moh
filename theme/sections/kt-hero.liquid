{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<style>
.kt-hero{position:relative;overflow:hidden;height:clamp(420px,60vh,640px);background:#000}
.kt-hslide{position:absolute;inset:0;opacity:0;transition:opacity .8s ease;display:flex;align-items:center;pointer-events:none}
.kt-hslide.is-active{opacity:1;z-index:1;pointer-events:auto}
.kt-hslide__img{position:absolute;inset:0;background-size:cover;background-position:center;transform:scale(1)}
.kt-hslide.is-active .kt-hslide__img{animation:ktken 7s ease-out forwards}
@keyframes ktken{from{transform:scale(1.16)}to{transform:scale(1.02)}}
.kt-hslide::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.62),rgba(0,0,0,.12))}
.kt-hslide__content{position:relative;z-index:3;color:#fff;padding:0 clamp(1.5rem,6vw,5rem);max-width:700px}
.kt-hslide__content h1,.kt-hslide__content .kt-hslide__title{font-size:clamp(2rem,5.5vw,4rem);margin:.5rem 0 1.5rem;font-weight:800;line-height:1.05}
.kt-hslide .hero__overlay-text{z-index:2}
.kt-hdots{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);z-index:6;display:flex;gap:.5rem}
.kt-hdots button{width:10px;height:10px;border-radius:50%;border:none;background:rgba(255,255,255,.5);cursor:pointer;padding:0;transition:width .2s,background .2s}
.kt-hdots button.is-active{background:#fff;width:26px;border-radius:6px}
.kt-harrow{position:absolute;top:50%;transform:translateY(-50%);z-index:6;background:rgba(0,0,0,.35);color:#fff;border:none;width:42px;height:42px;border-radius:50%;font-size:1.4rem;line-height:1;cursor:pointer}
.kt-harrow:hover{background:var(--red)}
.kt-harrow--prev{left:14px}.kt-harrow--next{right:14px}
</style>
<div class="kt" data-kt-section>
  <div class="kt-hero" data-kt-hero>
    {%- for block in section.blocks -%}
      <div class="kt-hslide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <div class="kt-hslide__img" {% if block.settings.image != blank %}style="background-image:url('{{ block.settings.image | image_url: width: 2200 }}')"{% else %}style="background:linear-gradient(120deg,#0b1b3a,#10241b,#0d2a1a)"{% endif %}></div>
        {%- if block.settings.overlay_text != blank -%}<div class="hero__overlay-text">{{ block.settings.overlay_text | newline_to_br }}</div>{%- endif -%}
        <div class="kt-hslide__content">
          {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          {%- if block.settings.heading != blank -%}
            {%- comment -%} Un seul H1 par page (SEO) : le 1er slide est le H1, les autres sont des titres visuels. {%- endcomment -%}
            {%- if forloop.first -%}
              <h1>{{ block.settings.heading | newline_to_br }}</h1>
            {%- else -%}
              <p class="kt-hslide__title">{{ block.settings.heading | newline_to_br }}</p>
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}<a href="{{ block.settings.button_link }}" class="btn btn--primary">{{ block.settings.button_label }}</a>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
    {%- if section.blocks.size > 1 -%}
      <button class="kt-harrow kt-harrow--prev" data-h-prev aria-label="Précédent">‹</button>
      <button class="kt-harrow kt-harrow--next" data-h-next aria-label="Suivant">›</button>
      <div class="kt-hdots">
        {%- for block in section.blocks -%}<button type="button" data-h-dot="{{ forloop.index0 }}" class="{% if forloop.first %}is-active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
<script>
(function(){
  var root=document.querySelector('[data-kt-hero]'); if(!root) return;
  var slides=root.querySelectorAll('.kt-hslide'); if(slides.length<2) return;
  var dots=root.querySelectorAll('[data-h-dot]'); var i=0,t;
  function go(n){ slides[i].classList.remove('is-active'); if(dots[i])dots[i].classList.remove('is-active'); i=(n+slides.length)%slides.length; slides[i].classList.add('is-active'); if(dots[i])dots[i].classList.add('is-active'); }
  function next(){go(i+1);} function prev(){go(i-1);}
  function start(){ stop(); t=setInterval(next, {{ section.settings.speed | default: 5 | times: 1000 }}); } function stop(){ if(t)clearInterval(t); }
  var n=root.querySelector('[data-h-next]'), p=root.querySelector('[data-h-prev]');
  if(n)n.addEventListener('click',function(){next();start();});
  if(p)p.addEventListener('click',function(){prev();start();});
  dots.forEach(function(d){d.addEventListener('click',function(){go(parseInt(d.getAttribute('data-h-dot'),10));start();});});
  root.addEventListener('mouseenter',stop); root.addEventListener('mouseleave',start);
  start();
})();
</script>

{% schema %}
{
  "name": "Héro KetShop",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "range", "id": "speed", "label": "Vitesse de défilement", "min": 3, "max": 8, "step": 1, "default": 5, "unit": "s" }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "ÉDITION LIMITÉE" },
      { "type": "textarea", "id": "heading", "label": "Titre", "default": "Maillot Collector\nChampions d'Europe" },
      { "type": "textarea", "id": "overlay_text", "label": "Texte filigrane (optionnel)" },
      { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir la collection" },
      { "type": "url", "id": "button_link", "label": "Lien du bouton" }
    ]}
  ],
  "presets": [ { "name": "KetShop — Héro (slides)", "blocks": [ { "type": "slide" }, { "type": "slide" } ] } ]
}
{% endschema %}
