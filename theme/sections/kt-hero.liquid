{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<div class="kt" data-kt-section>
  <section class="hero">
    {%- if section.settings.image != blank -%}
      <div class="hero__bg" style="background-image:url('{{ section.settings.image | image_url: width: 2000 }}');background-size:cover;background-position:center"></div>
      <div class="hero__bg" style="background:linear-gradient(90deg,rgba(0,0,0,.65),rgba(0,0,0,.15))"></div>
    {%- else -%}
      <div class="hero__bg"></div>
    {%- endif -%}
    {%- if section.settings.overlay_text != blank -%}
      <div class="hero__overlay-text">{{ section.settings.overlay_text | newline_to_br }}</div>
    {%- endif -%}
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Héro KetShop",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "ÉDITION LIMITÉE" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Maillot Collector\nChampions d'Europe" },
    { "type": "textarea", "id": "overlay_text", "label": "Texte filigrane", "default": "BACK\n2\nBACK" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir la collection" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [ { "name": "KetShop — Héro" } ]
}
{% endschema %}
