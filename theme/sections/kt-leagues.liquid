{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<style>
.leagues{display:flex;flex-wrap:wrap;justify-content:center;gap:1.6rem 2rem;padding:.8rem 0 1rem}
.kt-league{flex:1 1 130px;max-width:180px;display:flex;flex-direction:column;align-items:center;gap:.7rem;text-decoration:none;color:inherit}
.kt-league__logo{width:100%;max-width:160px;aspect-ratio:1;border-radius:12px;background:#fff;border:1px solid var(--grey-2);display:grid;place-items:center;overflow:hidden;font-weight:800;font-size:1rem;color:#333;text-align:center;transition:transform .15s,box-shadow .2s,border-color .2s}
.kt-league:hover .kt-league__logo{transform:translateY(-5px);box-shadow:0 14px 30px rgba(0,0,0,.15);border-color:var(--red)}
.kt-league__logo img{width:100%;height:100%;object-fit:cover}
.kt-league__name{font-size:.88rem;font-weight:600;text-align:center;line-height:1.2}
.kt-league:hover .kt-league__name{color:var(--red)}
.dark-strip .kt-league__name{color:#eee}
.dark-strip .kt-league__logo{background:#fff}
@media(max-width:600px){.kt-league{flex:1 1 40%}}
</style>
<div class="kt {% if section.settings.dark %}dark-strip{% endif %}" data-kt-section>
  <section class="section">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow center">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="center">{{ section.settings.heading }}</h2>
    <div class="leagues">
      {%- for block in section.blocks -%}
        <a class="kt-league" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="kt-league__logo">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.label | escape }}" loading="lazy">
            {%- else -%}
              {{ block.settings.label }}
            {%- endif -%}
          </span>
          {%- if block.settings.show_name -%}<span class="kt-league__name">{{ block.settings.label }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Ligues",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "PARCOURIR PAR LIGUE" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Toutes les ligues" },
    { "type": "checkbox", "id": "dark", "label": "Fond noir", "default": false }
  ],
  "blocks": [
    { "type": "league", "name": "Ligue", "settings": [
      { "type": "text", "id": "label", "label": "Nom", "default": "Ligue 1" },
      { "type": "image_picker", "id": "image", "label": "Logo de la ligue" },
      { "type": "url", "id": "link", "label": "Lien (collection de la ligue)" },
      { "type": "checkbox", "id": "show_name", "label": "Afficher le nom sous le logo", "default": true }
    ]}
  ],
  "presets": [ { "name": "KetShop — Ligues", "blocks": [
    { "type": "league", "settings": { "label": "Ligue 1" } },
    { "type": "league", "settings": { "label": "La Liga" } },
    { "type": "league", "settings": { "label": "Premier League" } },
    { "type": "league", "settings": { "label": "Bundesliga" } },
    { "type": "league", "settings": { "label": "Serie A" } },
    { "type": "league", "settings": { "label": "Coupe du monde" } }
  ]}]
}
{% endschema %}
