{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<div class="kt" data-kt-section>
  <section class="reviews">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow red center">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="center">{{ section.settings.heading }}</h2>
    <div class="reviews__score">
      <strong>{{ section.settings.score_label }}</strong>
      <span class="reviews__rating">{{ section.settings.rating }}</span>
      <span class="stars">★★★★★</span>
      <span class="reviews__count">{{ section.settings.count_text }}</span>
    </div>
    <div class="reviews__grid">
      {%- for block in section.blocks -%}
        <article class="review" {{ block.shopify_attributes }}>
          <span class="stars">★★★★★</span>
          <p>{{ block.settings.text }}</p>
          <div class="review__author"><span class="avatar">{{ block.settings.initial }}</span> {{ block.settings.author }}</div>
        </article>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Avis clients",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "AVIS CLIENTS" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce qu'ils pensent de nous" },
    { "type": "text", "id": "score_label", "label": "Mention", "default": "Excellent" },
    { "type": "text", "id": "rating", "label": "Note", "default": "4.8 / 5" },
    { "type": "text", "id": "count_text", "label": "Texte nombre d'avis", "default": "Voir nos 1 523 avis vérifiés" }
  ],
  "blocks": [
    { "type": "review", "name": "Avis", "settings": [
      { "type": "textarea", "id": "text", "label": "Avis", "default": "Qualité top, taille conforme, je recommande !" },
      { "type": "text", "id": "author", "label": "Auteur", "default": "Karim L." },
      { "type": "text", "id": "initial", "label": "Initiale", "default": "K" }
    ]}
  ],
  "presets": [ { "name": "KetShop — Avis clients", "blocks": [
    { "type": "review", "settings": { "text": "Franchement lourd, le flocage est propre. Reçu vite, le rendu en vrai est encore mieux.", "author": "Yanis M.", "initial": "Y" } },
    { "type": "review", "settings": { "text": "Qualité top, taille conforme, maillot identique à la description. Je recommande !", "author": "Karim L.", "initial": "K" } },
    { "type": "review", "settings": { "text": "Très beau maillot, livraison rapide. Le flocage est nickel, je reviendrai.", "author": "Thomas R.", "initial": "T" } }
  ]}]
}
{% endschema %}
