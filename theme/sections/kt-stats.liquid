{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<div class="kt" data-kt-section>
  <section class="stats">
    <div class="stats__img" {% if section.settings.image != blank %}style="background-image:url('{{ section.settings.image | image_url: width: 1400 }}');background-size:cover;background-position:center"{% endif %}></div>
    <div class="stats__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow red">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="stats__grid">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <span class="stats__num">{{ block.settings.number }}</span>
            <span class="stats__lbl">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Statistiques",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "NOTRE COMMUNAUTÉ" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Passionnés de foot depuis 2018" }
  ],
  "blocks": [
    { "type": "stat", "name": "Statistique", "settings": [
      { "type": "text", "id": "number", "label": "Chiffre", "default": "+41 843" },
      { "type": "text", "id": "label", "label": "Libellé", "default": "Clients satisfaits" }
    ]}
  ],
  "presets": [ { "name": "KetShop — Statistiques", "blocks": [
    { "type": "stat", "settings": { "number": "+41 843", "label": "Clients satisfaits" } },
    { "type": "stat", "settings": { "number": "+279", "label": "Modèles disponibles" } },
    { "type": "stat", "settings": { "number": "4.8/5", "label": "Note moyenne" } }
  ]}]
}
{% endschema %}
