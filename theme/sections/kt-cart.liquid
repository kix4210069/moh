{{ 'kt-home.css' | asset_url | stylesheet_tag }}
{{ 'kt-cart.css' | asset_url | stylesheet_tag }}
<div class="kt" data-kt-section>
  <div class="kt-cart">
    <div class="kt-cart__head">
      <h1>{{ section.settings.heading }}</h1>
      <a href="{{ routes.all_products_collection_url }}">← Continuer mes achats</a>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="kt-empty-cart">
        <h2>{{ section.settings.empty_title }}</h2>
        <p>{{ section.settings.empty_text }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Voir les maillots</a>
      </div>
    {%- else -%}

      {%- assign thr = section.settings.free_ship_eur | times: 100 -%}
      {%- assign remaining = thr | minus: cart.total_price -%}
      <div class="kt-ship">
        <div class="kt-ship__text">
          {%- if remaining > 0 -%}
            Plus que <b>{{ remaining | money }}</b> pour la <b>livraison offerte</b> 🚚
            {%- assign pct = cart.total_price | times: 100 | divided_by: thr -%}
          {%- else -%}
            🎉 Bravo ! Vous bénéficiez de la <b>livraison offerte</b>
            {%- assign pct = 100 -%}
          {%- endif -%}
        </div>
        <div class="kt-ship__track"><div class="kt-ship__fill" style="width: {{ pct }}%"></div></div>
      </div>

      <form action="{{ routes.cart_url }}" method="post" id="kt-cart-form">
        <div class="kt-cart__grid">
          <div>
            <div class="kt-items">
              {%- for item in cart.items -%}
                <div class="kt-item">
                  <a href="{{ item.url }}" class="kt-item__img">
                    {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}">{%- endif -%}
                  </a>
                  <div>
                    <div class="kt-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
                    <div class="kt-item__meta">
                      {%- unless item.variant.title contains 'Default' -%}<span>{{ item.variant.title }}</span>{%- endunless -%}
                      {%- for p in item.properties -%}
                        {%- unless p.last == blank or p.first contains '_' -%}<span>{{ p.first }} : {{ p.last }}</span>{%- endunless -%}
                      {%- endfor -%}
                    </div>
                    <a href="{{ item.url_to_remove }}" class="kt-item__remove">Supprimer</a>
                  </div>
                  <div class="kt-item__right">
                    <div class="kt-item__price">
                      {{ item.final_line_price | money }}
                      {%- if item.original_line_price > item.final_line_price -%}<span class="old">{{ item.original_line_price | money }}</span>{%- endif -%}
                    </div>
                    <div class="kt-cqty">
                      <button type="button" data-cqty="minus" aria-label="Moins">−</button>
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                      <button type="button" data-cqty="plus" aria-label="Plus">+</button>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>

            {%- if section.settings.show_note -%}
              <div class="kt-note">
                <label for="kt-note">Note de commande (optionnel)</label>
                <textarea id="kt-note" name="note" placeholder="Instructions, demande spéciale...">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            <button type="submit" name="update" class="btn btn--outline" style="margin-top:1rem;color:#111;border-color:#111">Mettre à jour le panier</button>
          </div>

          <aside class="kt-summary">
            <h2>Récapitulatif</h2>
            <div class="kt-summary__row"><span>Sous-total</span><span>{{ cart.total_price | money }}</span></div>
            {%- if cart.total_discount > 0 -%}
              <div class="kt-summary__row"><span>Réductions</span><span>− {{ cart.total_discount | money }}</span></div>
            {%- endif -%}
            <div class="kt-summary__total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
            <p class="kt-summary__taxes">Taxes et frais de livraison calculés à l'étape suivante.</p>

            <button type="submit" name="checkout" class="kt-checkout">Commander</button>
            <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
            <a href="{{ routes.all_products_collection_url }}" class="kt-cont">ou continuer mes achats</a>

            <ul class="kt-reassure">
              <li><span class="ok">✓</span> {{ section.settings.re1 }}</li>
              <li><span class="ok">✓</span> {{ section.settings.re2 }}</li>
              <li><span class="ok">✓</span> {{ section.settings.re3 }}</li>
            </ul>
            <div class="kt-paypics">
              {%- assign pays = section.settings.payments | split: ',' -%}
              {%- for p in pays -%}<span class="pay">{{ p | strip }}</span>{%- endfor -%}
            </div>
          </aside>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>
<script src="{{ 'kt-cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Panier KetShop",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Mon panier" },
    { "type": "number", "id": "free_ship_eur", "label": "Seuil livraison offerte (€)", "default": 60 },
    { "type": "checkbox", "id": "show_note", "label": "Afficher la note de commande", "default": true },
    { "type": "text", "id": "re1", "label": "Réassurance 1", "default": "Paiement 100% sécurisé" },
    { "type": "text", "id": "re2", "label": "Réassurance 2", "default": "Retours faciles sous 30 jours" },
    { "type": "text", "id": "re3", "label": "Réassurance 3", "default": "Livraison suivie en Europe" },
    { "type": "text", "id": "payments", "label": "Moyens de paiement", "default": "AMEX, Pay, CB, Maestro, MC, PayPal, VISA" },
    { "type": "text", "id": "empty_title", "label": "Titre panier vide", "default": "Votre panier est vide" },
    { "type": "text", "id": "empty_text", "label": "Texte panier vide", "default": "Découvrez nos maillots et profitez de l'offre 2 achetés = 1 offert !" }
  ],
  "presets": [ { "name": "KetShop — Panier" } ]
}
{% endschema %}
