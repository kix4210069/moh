{{ 'kt-home.css' | asset_url | stylesheet_tag }}
{{ 'kt-drawer.css' | asset_url | stylesheet_tag }}
{{ 'kt-searchbar.css' | asset_url | stylesheet_tag }}
{{ 'kt-menu.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kt-drawer.js' | asset_url }}" defer></script>
<script src="{{ 'kt-searchbar.js' | asset_url }}" defer></script>
<script src="{{ 'kt-menu.js' | asset_url }}" defer></script>
<div class="kt" data-kt-section>
  <header class="header">
    <button type="button" class="icon-btn nav-toggle" aria-label="Menu" data-kt-menu-toggle>
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 600 }}" alt="{{ shop.name }}" style="max-height:{{ section.settings.logo_height | default: 70 }}px;width:auto">
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/1020/3948/6807/files/ChatGPT_Image_11_mars_2026_22_57_45_77d46329-8e12-4508-a068-41afd3b4df5c.png" alt="{{ shop.name }}" style="max-height:{{ section.settings.logo_height | default: 70 }}px;width:auto">
      {%- endif -%}
    </a>

    <div class="header__actions">
      <button class="pill">{{ section.settings.region_text }} <span class="chev">▾</span></button>
      <button type="button" class="icon-btn" aria-label="Recherche" data-kt-search-toggle>🔍</button>
      <a href="{{ routes.account_url }}" class="icon-btn" aria-label="Compte">👤</a>
      <a href="{{ routes.cart_url }}" class="icon-btn cart" aria-label="Panier">🛍️<span class="cart__badge">{{ cart.item_count }}</span></a>
    </div>
  </header>
</div>
<script src="{{ 'kt-home.js' | asset_url }}" defer></script>

<!-- Menu latéral -->
<div class="kt-menu-overlay" data-kt-menu-overlay></div>
<aside class="kt-menu" data-kt-menu aria-hidden="true">
  <div class="kt-menu__head"><strong>{{ section.settings.menu_title }}</strong><button class="kt-menu__close" data-kt-menu-close aria-label="Fermer">✕</button></div>
  <ul class="kt-menu__list">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <li>
          <div class="kt-menu__row">
            <a href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}<button type="button" class="kt-menu__toggle" data-kt-sub aria-label="Déplier">+</button>{%- endif -%}
          </div>
          {%- if link.links.size > 0 -%}
            <ul class="kt-menu__sub">
              {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
  <div class="kt-menu__foot">
    <a href="{{ routes.account_url }}">👤 Mon compte</a>
    <a href="{{ routes.cart_url }}">🛍️ Panier</a>
  </div>
</aside>

{%- comment -%} Données structurées SEO (rich results Google) — présentes sur toutes les pages {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | append: '/' | json }},
  "logo": {%- if section.settings.logo != blank -%}{{ section.settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{%- else -%}"https://cdn.shopify.com/s/files/1/1020/3948/6807/files/ChatGPT_Image_11_mars_2026_22_57_45_77d46329-8e12-4508-a068-41afd3b4df5c.png"{%- endif -%},
  "description": {{ shop.description | default: shop.name | json }}
  {%- if section.settings.instagram != blank or section.settings.tiktok != blank -%}
  ,"sameAs": [
    {%- assign sep = '' -%}
    {%- if section.settings.instagram != blank -%}{{ section.settings.instagram | json }}{%- assign sep = ',' -%}{%- endif -%}
    {%- if section.settings.tiktok != blank -%}{{ sep }}{{ section.settings.tiktok | json }}{%- endif -%}
  ]
  {%- endif -%}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | append: '/' | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{% schema %}
{
  "name": "En-tête KetShop",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (image, optionnel)" },
    { "type": "range", "id": "logo_height", "label": "Hauteur du logo (px)", "min": 30, "max": 130, "step": 2, "default": 70, "unit": "px" },
    { "type": "text", "id": "logo_text", "label": "Texte du logo", "default": "KETSHOP" },
    { "type": "text", "id": "logo_sub", "label": "Sous-texte du logo", "default": "MAILLOT" },
    { "type": "link_list", "id": "menu", "label": "Menu de navigation" },
    { "type": "text", "id": "menu_title", "label": "Titre du menu latéral", "default": "Menu" },
    { "type": "text", "id": "region_text", "label": "Texte pays/devise", "default": "France | EUR €" }
  ],
  "presets": [ { "name": "KetShop — En-tête" } ]
}
{% endschema %}
