{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<style>
.feature{position:relative}
.kt-fbadge{position:absolute;top:16px;left:16px;z-index:4;background:var(--red);color:#fff;font-weight:800;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;padding:.4rem .75rem;border-radius:6px;box-shadow:0 4px 14px rgba(0,0,0,.25);animation:ktblink 1.1s ease-in-out infinite}
@keyframes ktblink{0%,100%{opacity:1}50%{opacity:.2}}
</style>
<div class="kt" data-kt-section>
  <section class="feature {% if section.settings.reverse %}feature--reverse{% endif %}">
    {%- if section.settings.badge != blank -%}<span class="kt-fbadge">{{ section.settings.badge }}</span>{%- endif -%}
    <div class="feature__img" {% if section.settings.image != blank %}style="background-image:url('{{ section.settings.image | image_url: width: 1400 }}');background-size:{{ section.settings.image_fit | default: 'cover' }};background-repeat:no-repeat;background-position:center"{% endif %}></div>
    <div class="feature__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow red">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h3>{{ section.settings.heading | newline_to_br }}</h3>
      {%- if section.settings.price != blank -%}<p class="price">{{ section.settings.price }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Bannière mise en avant",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge", "label": "Badge clignotant (coin haut gauche)", "info": "Laissez vide pour ne pas l'afficher." },
    { "type": "select", "id": "image_fit", "label": "Ajustement de l'image", "options": [ { "value": "cover", "label": "Remplir (recadrée)" }, { "value": "contain", "label": "Image entière (non recadrée)" } ], "default": "cover" },
    { "type": "checkbox", "id": "reverse", "label": "Inverser (texte à gauche)", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Maillot Real Madrid Domicile\n2026/2027" },
    { "type": "text", "id": "price", "label": "Prix (texte libre)", "default": "€29,90" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Acheter" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [ { "name": "KetShop — Bannière" } ]
}
{% endschema %}
