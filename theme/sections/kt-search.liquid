{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<style>
.kt-coll{max-width:var(--maxw);margin:0 auto;padding:2rem clamp(1rem,4vw,2rem)}
.kt-coll__head h1{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;margin-bottom:1rem}
.kt-search__form{position:relative;max-width:560px;margin-bottom:2rem}
.kt-search__form input{width:100%;border:1px solid #ccc;border-radius:30px;padding:.9rem 1.1rem .9rem 2.6rem;font:inherit;background:#fff}
.kt-search__form .ic{position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--muted)}
.kt-coll__count{font-size:.85rem;color:var(--muted);border-top:1px solid var(--grey-2);border-bottom:1px solid var(--grey-2);padding:.8rem 0;margin-bottom:1.6rem}
.kt-coll-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1.2rem}
.kt-coll-grid .card__media{aspect-ratio:1/1}
.kt-coll-empty{padding:3rem 1rem;text-align:center;color:var(--muted)}
.kt-coll__pagination{display:flex;justify-content:center;gap:.5rem;margin-top:2rem}
.kt-coll__pagination a,.kt-coll__pagination span{padding:.5rem .85rem;border:1px solid var(--grey-2);border-radius:8px;font-size:.85rem;text-decoration:none;color:inherit}
.kt-coll__pagination .current{background:var(--red);color:#fff;border-color:var(--red)}
@media(max-width:1100px){.kt-coll-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:900px){.kt-coll-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:640px){.kt-coll-grid{grid-template-columns:repeat(2,1fr);gap:1rem}}
</style>
<div class="kt" data-kt-section>
  <div class="kt-coll">
    <div class="kt-coll__head"><h1>{{ section.settings.heading }}</h1></div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="kt-search__form">
      <span class="ic">🔍</span>
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder }}" aria-label="Rechercher">
      <input type="hidden" name="type" value="product">
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by section.settings.per_page -%}
        <div class="kt-coll__count">{{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %} pour « {{ search.terms }} »</div>
        {%- if search.results_count > 0 -%}
          <div class="kt-coll-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <a class="card" href="{{ item.url }}">
                  <div class="card__media">
                    {%- if item.compare_at_price > item.price -%}<span class="card__badge">{{ section.settings.badge }}</span>{%- endif -%}
                    {%- if item.featured_image -%}<img src="{{ item.featured_image | image_url: width: 600 }}" alt="{{ item.title | escape }}" loading="lazy">{%- endif -%}
                  </div>
                  <div class="card__title">{{ item.title }}</div>
                  <div class="card__price">{{ item.price | money }}{%- if item.compare_at_price > item.price -%}<span class="old">{{ item.compare_at_price | money }}</span>{%- endif -%}</div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<div class="kt-coll__pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
        {%- else -%}
          <div class="kt-coll-empty">Aucun résultat. Essayez un autre nom d'équipe ou de joueur.</div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      {%- paginate collections.all.products by section.settings.per_page -%}
        <div class="kt-coll__count">Produits</div>
        <div class="kt-coll-grid">
          {%- for product in collections.all.products -%}
            <a class="card" href="{{ product.url }}">
              <div class="card__media">
                {%- if product.compare_at_price > product.price -%}<span class="card__badge">{{ section.settings.badge }}</span>{%- endif -%}
                {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
              </div>
              <div class="card__title">{{ product.title }}</div>
              <div class="card__price">{{ product.price | money }}{%- if product.compare_at_price > product.price -%}<span class="old">{{ product.compare_at_price | money }}</span>{%- endif -%}</div>
            </a>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<div class="kt-coll__pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Recherche KetShop",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Rechercher" },
    { "type": "text", "id": "placeholder", "label": "Texte du champ", "default": "Rechercher un maillot, une équipe..." },
    { "type": "range", "id": "per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "text", "id": "badge", "label": "Texte du badge promo", "default": "PROMO" }
  ],
  "presets": [ { "name": "KetShop — Recherche" } ]
}
{% endschema %}
