{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<style>.section__actions{display:flex;align-items:center;gap:1rem}.kt-seeall{color:var(--red);font-weight:700;font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;white-space:nowrap}.kt-seeall:hover{text-decoration:underline}</style>
{%- assign col = section.settings.collection -%}
<div class="kt {% if section.settings.dark %}dark-strip{% endif %}" data-kt-section>
  <section class="section">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="section__actions">
        {%- if section.settings.show_view_all and col != blank -%}
          <a class="kt-seeall" href="{{ col.url }}">{{ section.settings.view_all_label }}</a>
        {%- endif -%}
        <div class="arrows" data-arrows>
          <button class="arrow" data-scroll="prev" aria-label="Précédent">‹</button>
          <button class="arrow" data-scroll="next" aria-label="Suivant">›</button>
        </div>
      </div>
    </div>

    {%- if col != blank and col.products_count > 0 -%}
      <div class="product-row" data-row>
        {%- for product in col.products limit: section.settings.count -%}
          <a class="card" href="{{ product.url }}">
            <div class="card__media">
              {%- if product.compare_at_price > product.price -%}
                <span class="card__badge">{{ section.settings.badge }}</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="card__title">{{ product.title }}</div>
            <div class="card__price">
              {{ product.price | money }}
              {%- if product.compare_at_price > product.price -%}
                <span class="old">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="kt-empty">Sélectionnez une collection (avec des produits) dans les réglages de cette section pour afficher vos maillots ici.</div>
    {%- endif -%}
  </section>
</div>
<script src="{{ 'kt-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Rangée de produits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "SÉLECTION" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos maillots du moment" },
    { "type": "collection", "id": "collection", "label": "Collection à afficher" },
    { "type": "range", "id": "count", "label": "Nombre de produits", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "badge", "label": "Texte du badge promo", "default": "PROMO" },
    { "type": "checkbox", "id": "show_view_all", "label": "Afficher « Voir tout »", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texte « Voir tout »", "default": "Voir tout" },
    { "type": "checkbox", "id": "dark", "label": "Fond noir", "default": false }
  ],
  "presets": [ { "name": "KetShop — Rangée de produits" } ]
}
{% endschema %}
