{{ 'kt-home.css' | asset_url | stylesheet_tag }}
<div class="kt dark-strip" data-kt-section>
  <section class="section">
    <div class="section__head"><div><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="top-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="top-card" {{ block.shopify_attributes }}
           {% if block.settings.image != blank %}style="background-image:url('{{ block.settings.image | image_url: width: 700 }}');background-size:cover;background-position:center"{% endif %}>
          <span>{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Top maillots (grille)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Top Maillots du moment" }
  ],
  "blocks": [
    { "type": "card", "name": "Carte", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Libellé", "default": "Saint-Germain" },
      { "type": "url", "id": "link", "label": "Lien" }
    ]}
  ],
  "presets": [ { "name": "KetShop — Top maillots", "blocks": [
    { "type": "card", "settings": { "label": "Saint-Germain" } },
    { "type": "card", "settings": { "label": "Real Madrid" } },
    { "type": "card", "settings": { "label": "FC Barcelone" } },
    { "type": "card", "settings": { "label": "Équipe de France" } }
  ]}]
}
{% endschema %}
