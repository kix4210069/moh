{{ 'kt-home.css' | asset_url | stylesheet_tag }}
{{ 'kt-product.css' | asset_url | stylesheet_tag }}
<div class="kt" data-kt-section>
  <section class="kt-community">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow red center">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="center">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtitle != blank -%}<p class="kt-community__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    <div class="kt-photos">
      {%- for block in section.blocks -%}
        {%- if block.type == 'photo' -%}
          <a class="kt-photo" href="{{ block.settings.link | default: section.settings.instagram }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="">{%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="kt-igbtn" href="{{ section.settings.instagram }}">📷 {{ section.settings.button_label }}</a>
    {%- endif -%}
  </section>

  <div class="kt-statbar">
    <div class="kt-statbar__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div {{ block.shopify_attributes }}><span class="num">{{ block.settings.number }}</span><span class="lbl">{{ block.settings.label }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Communauté",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "COMMUNAUTÉ" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils portent nos maillots" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Rejoins la communauté KetShop" },
    { "type": "url", "id": "instagram", "label": "Lien Instagram" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir notre Instagram" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "link", "label": "Lien" }
    ]},
    { "type": "stat", "name": "Statistique", "settings": [
      { "type": "text", "id": "number", "label": "Chiffre", "default": "+81 303" },
      { "type": "text", "id": "label", "label": "Libellé", "default": "Maillots livrés" }
    ]}
  ],
  "presets": [ { "name": "KetShop — Communauté", "blocks": [
    { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
    { "type": "stat", "settings": { "number": "+81 303", "label": "Maillots livrés" } },
    { "type": "stat", "settings": { "number": "+542", "label": "Maillots disponibles" } },
    { "type": "stat", "settings": { "number": "4.8 ★", "label": "Note moyenne" } }
  ]}]
}
{% endschema %}
