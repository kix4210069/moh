{%- comment -%} Vraies icônes de paiement Shopify {%- endcomment -%}
<style>.kt-payicons{display:inline-flex;gap:.35rem;flex-wrap:wrap;align-items:center}.kt-payicons .payment-icon,.kt-payicons svg{height:24px;width:auto;border-radius:4px;box-shadow:0 0 0 1px rgba(0,0,0,.06)}</style>
{%- assign kt_types = shop.enabled_payment_types -%}
{%- if kt_types == empty or kt_types == blank -%}
  {%- assign kt_types = "visa,master,american_express,maestro,paypal,apple_pay,google_pay" | split: "," -%}
{%- endif -%}
<span class="kt-payicons">
  {%- for type in kt_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
</span>
